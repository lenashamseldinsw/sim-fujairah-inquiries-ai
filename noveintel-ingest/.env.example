# ─────────────────────────────────────────────────────────────────────────────
# NoveIntelligence — document ingestion
#
# Copy to .env and fill in. Only CORE42_API_KEY is required to embed; `inspect`
# and `faq-catalogue` make no model call and need nothing. Every commented line
# shows the default used without it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core42 gateway ───────────────────────────────────────────────────────────
CORE42_API_KEY=
#CORE42_BASE_URL=https://api.core42.ai/v1

# The embedding model. Only the two approved embedding models are accepted:
#   text-embedding-3-large   Embeddings 3 Large (default)
#   qwen3-embedding          Qwen3 Embedding 8B (overloaded on Core42, 2026-10-16)
# Anything else is refused. A collection is bound to the model that created it.
#CORE42_MODEL_EMBED=text-embedding-3-large

# Stored vector size. Both models are Matryoshka-trained, so a vector is cut to
# this size and re-normalised on our side (no gateway support needed). 1024 keeps
# pgvector's HNSW index available (it indexes up to 2000 dimensions).
#NOVEINGEST_EMBED_DIMENSIONS=1024
#NOVEINGEST_EMBED_BATCH=64

#LLM_MAX_RETRIES=2
#LLM_RETRY_DELAY=2
#CORE42_REQUEST_TIMEOUT=120

# ── Vector store ─────────────────────────────────────────────────────────────
# Unset: an embedded Postgres + pgvector is started in NOVEINGEST_PG_DATA_DIR
# (needs the `local` extra). Set: any Postgres with the vector extension.
#NOVEINGEST_PG_DSN=postgresql://user:password@host:5432/dbname
#NOVEINGEST_PG_DATA_DIR=.pgdata
