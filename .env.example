# ─────────────────────────────────────────────────────────────────────────────
# Application Mode
# ─────────────────────────────────────────────────────────────────────────────
# Set to either 'demo' or 'real'
# - demo: Uses simulated data with pre-built reports (default for main branch)
# - real: Uses agentic AI for live analysis (development on real branch)
APP_MODE=demo

# ─────────────────────────────────────────────────────────────────────────────
# Core42 (required by the real version only — the demo makes no LLM calls)
# ─────────────────────────────────────────────────────────────────────────────
# Core42 is an OpenAI-compatible gateway; the app talks to it with the openai
# SDK over this base URL. Both endpoints share the same key.
CORE42_API_KEY=
# NO /chat/completions suffix — the SDK appends the path itself. A trailing
# /chat/completions is stripped automatically, but set it clean here.
CORE42_BASE_URL=https://api.core42.ai/v1

# Two model tiers. The reasoning tier runs analysis, gap analysis and the report
# prose; the fast tier runs bulk per-case classification (Stage 3). Point both
# at the same deployment if only one is provisioned.
CORE42_MODEL=
CORE42_MODEL_FAST=

# ─────────────────────────────────────────────────────────────────────────────
# Limits
# ─────────────────────────────────────────────────────────────────────────────
# Hard ceiling on output tokens for a single call (sent as max_completion_tokens).
LLM_MAX_OUTPUT_TOKENS=32768
# Reasoning models spend part of the output budget on reasoning tokens that never
# reach the reply, so each call site's max_tokens is multiplied by this before
# being sent. Lower it to 1.0 if the deployment's model does not reason.
LLM_OUTPUT_TOKEN_HEADROOM=1.5
# Seconds. Set well clear of the measured p99, not just above the median: a
# merely slow call that gets killed and retried costs more than letting it run.
LLM_TIMEOUT=240
# In-flight Core42 requests PER PROCESS (0 = uncapped). Stage 3 fans out to 5
# threads, Stage 6 to 7 and the English translation to 9 — this is the cap that
# keeps all of them inside what the gateway tolerates. Raising it past the
# endpoint's ceiling makes a run *slower*, because every 429 costs a back-off.
LLM_MAX_CONCURRENCY=4

# ─────────────────────────────────────────────────────────────────────────────
# Retries
# ─────────────────────────────────────────────────────────────────────────────
# Attempts = LLM_MAX_RETRIES + 1. Deterministic failures (bad key, bad model,
# malformed request) are never retried; 429s use a 10s floor of their own.
LLM_MAX_RETRIES=2
LLM_RETRY_DELAY=2.0

# ─────────────────────────────────────────────────────────────────────────────
# Optional
# ─────────────────────────────────────────────────────────────────────────────
# Accepted and NOT sent: gpt-5.1-class reasoning models reject a non-default
# temperature. Kept so the setting needs no churn if that changes.
LLM_TEMPERATURE=0.2
# Tool calling: 'auto' (default) uses native function calling and falls back to
# JSON mode if the deployment rejects it; 'native' never falls back; 'json'
# always uses the JSON-mode emulation.
CORE42_TOOL_MODE=auto
