# What must never reach wwwroot.
#
# .venv is the big one: it is hundreds of megabytes, and the platform installs from
# requirements.txt anyway. Shipping it makes deployments slow and can shadow the
# platform's own packages.
.venv/
.python-version
uv.lock

# Secrets, and the files that hold them locally.
local.settings.json
.env

# Development-only.
tests/
scripts/
docs/
fixtures/
bundle.json
openapi.json
out/

# The local document and job stores' contents (.data/), and the pre-.data/ defaults.
# Anchored: unanchored, /storage/ and /jobs/ would also exclude the noveintel_inquiries/storage/
# and noveintel_inquiries/jobs/ packages, and the app would not import.
/.data/
/storage/
/jobs/

.pytest_cache/
.vscode/
.git*
__pycache__/
*.pyc
*.pyo
README.md
