# ─────────────────────────────────────────────────────────────────────────────
# NoveIntelligence — Customer Inquiries Analytics
#
# Copy to .env and fill in. Only CORE42_API_KEY is required; every other line
# here is commented out and shows the default the service uses without it.
#
# Settings are read once and cached, and the Core42 client is a module-level
# singleton, so editing this file while the service runs changes nothing. Restart
# the process.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core42 gateway (required) ────────────────────────────────────────────────
CORE42_API_KEY=

# The OpenAI-compatible endpoint. A trailing /chat/completions is stripped
# automatically, so either form of the URL your deployment hands out will work.
#CORE42_BASE_URL=https://api.core42.ai/v1

# Two tiers. The reasoning model writes the analysis and the report prose; the
# fast model does bulk per-case classification in stage 3. Leave the fast tier
# unset to use the same model for both.
#CORE42_MODEL=gpt-5.1
#CORE42_MODEL_FAST=

# The deep review's model (the second, higher-effort classification pass) and
# how hard it reasons. gpt-5.1 does no reasoning unless asked, so the effort is
# what makes the deep review deeper: none · minimal · low · medium · high · xhigh.
# "none" sends no effort. A model that rejects the parameter is asked again
# without it. Unset model: CORE42_MODEL.
#CORE42_MODEL_DEEP=
#LLM_DEEP_REASONING_EFFORT=low

# The light tier: auxiliary steps measured to hold on a smaller model — today umbrella
# discovery after its first chunk (assigning root causes to umbrellas already named).
# Recommended: gpt-4.1-mini. Not used for classification or the FAQ judge: measured on
# reviewed ADPF cases, gpt-4.1-mini lost 8–10 points of classification accuracy and
# agreed with gpt-5.1's FAQ verdicts on 23% of groups (gpt-5.1 with itself: 91%).
# Unset: CORE42_MODEL.
#CORE42_MODEL_LIGHT=gpt-4.1-mini

# FAQ detection's embedding model (Section 04): groups the cases' questions and
# shortlists the catalogue entries the model then judges. Only the approved
# embedding models are accepted — text-embedding-3-large (default) or
# qwen3-embedding (overloaded on Core42 when tried, 2026-10-16). Vectors are cut to
# CORE42_EMBED_DIMENSIONS and re-normalised; 1024 scored the same as the full size.
# Embedding tokens are priced at CORE42_INPUT_COST_PER_1M like every other token,
# which overstates them (a Q2-sized run embeds a few hundred thousand tokens).
#CORE42_MODEL_EMBED=text-embedding-3-large
#CORE42_EMBED_DIMENSIONS=1024

# Per-call timeout in seconds. Generous on purpose: a report section is a long
# structured generation.
#CORE42_REQUEST_TIMEOUT=240

# ── Pricing (optional) ───────────────────────────────────────────────────────
# USD per 1,000,000 tokens, copied straight off your contract. Both are needed
# or neither is used: with either unset, a run reports its tokens and a null
# cost, and carries a 'pricing_not_configured' warning. That is deliberate — an
# unpriced run and a free one are different facts.
#CORE42_INPUT_COST_PER_1M=
#CORE42_OUTPUT_COST_PER_1M=

# ── Model-call behaviour (optional) ──────────────────────────────────────────
# Read by the vendored Core42 layer rather than by the API settings.
#
# In-flight requests per process. Stage 3 fans out to 5 threads and stage 6 to 7,
# so without a cap the gateway sees far more concurrency than it tolerates and
# answers with 429s — and a 429's back-off costs more wall clock than the
# concurrency saved. Raising this usually makes a run slower.
#LLM_MAX_CONCURRENCY=5
# A 429 halves the cap above and clean calls grow it back, so several instances
# sharing one Core42 key back off together. false keeps the cap fixed.
#LLM_ADAPTIVE_CONCURRENCY=true
#LLM_MAX_RETRIES=2
#LLM_RETRY_DELAY=2
#LLM_TIMEOUT=240
# Reasoning models spend part of the output budget on tokens that never reach
# `content`, so a call asking for 8000 visible tokens needs headroom or it
# truncates mid-JSON.
#LLM_MAX_OUTPUT_TOKENS=32768
#LLM_OUTPUT_TOKEN_HEADROOM=1.5

# ── This service (optional) ──────────────────────────────────────────────────
# Set to require an X-API-Key header on every /v1 request. Leave unset behind a
# gateway that already authenticates — on Azure Functions the platform checks its
# own function key before a request reaches the app.
#NOVEINQ_API_KEY=

#NOVEINQ_LOG_LEVEL=INFO

# Largest export the service will accept. The whole thing is held in a dataframe,
# so raising this means checking the worker has the memory.
#NOVEINQ_MAX_RECORDS=100000

# ── Jobs (optional) ──────────────────────────────────────────────────────────
# Runs are asynchronous: the work route records a job and the caller polls.
#
# Two independent choices. BACKEND says where job state lives: 'local' is this
# worker's memory mirrored to disk — not durable across a restart, and invisible
# to other instances — while 'table' is Azure Table Storage, which is both.
# DISPATCH says where the run executes: 'inprocess' on this worker's event loop,
# or 'queue' for a queue-triggered function to pick up, which is what makes a run
# survive the worker that accepted it.
#
# Development: local + inprocess (the defaults).  Production: table + queue.
# Set both together — with 'local', a queue worker writes to its own memory and
# the instance serving the poll never sees it. See README.md.
#NOVEINQ_JOB_BACKEND=local
#NOVEINQ_JOB_DISPATCH=inprocess
#NOVEINQ_JOB_CONNECTION_STRING=
# Named per service so both services can share one storage account. Table names
# allow letters and digits only.
#NOVEINQ_JOB_TABLE_NAME=inquiriesjobs
#NOVEINQ_JOB_QUEUE_NAME=inquiries-runs
#NOVEINQ_JOB_DIR=.data/jobs
# How long a finished job stays pollable. The artefacts in storage outlive this.
#NOVEINQ_JOB_TTL_SEC=86400
# Wall-clock ceiling for one run. Past it the run is abandoned and reported failed,
# so a wedged model call cannot hold a worker slot forever.
#NOVEINQ_JOB_MAX_RUNTIME_SEC=3600
# Runs executing at once in one worker. About memory, not gateway pressure —
# LLM_MAX_CONCURRENCY caps the requests.
#NOVEINQ_JOB_MAX_CONCURRENT=2

# ── Storage (optional) ───────────────────────────────────────────────────────
# Where finished artefacts go.
#   local  a directory on this server's disk. The default, and the on-prem choice:
#          no Azure account and no Azure package needed.
#   blob   Azure Blob Storage. For Azure, where several instances must share files
#          and callers need download links. Needs the 'azure' extra and a
#          connection string — include AccountKey so links can be signed.
# See docs/deployment.md.
#NOVEINQ_STORAGE_BACKEND=local
#NOVEINQ_STORAGE_CONNECTION_STRING=
#NOVEINQ_STORAGE_DIR=.data/storage
#NOVEINQ_STORAGE_CONTAINER=inquiries-reports
# How long a 'blob' download link works, in seconds (default one week).
#NOVEINQ_STORAGE_SAS_TTL_SEC=604800
# Unset means DocumentRef.url is a file: URI, which is honest about being on the
# service's disk. Set it to whatever serves the storage directory and the URLs
# become fetchable:  python -m http.server 10000 -d .data/storage
#NOVEINQ_STORAGE_PUBLIC_BASE_URL=
