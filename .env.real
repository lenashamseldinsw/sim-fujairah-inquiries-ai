# Real Mode Configuration (reference copy — the app loads real/.env)
# This file is for running the full agentic AI implementation on the real branch.
APP_MODE=real

# ── Core42 (required) ────────────────────────────────────────────────────────
# Full setting list and explanations: .env.example
CORE42_API_KEY=
CORE42_BASE_URL=https://api.core42.ai/v1
CORE42_MODEL=
CORE42_MODEL_FAST=

LLM_MAX_OUTPUT_TOKENS=32768
LLM_OUTPUT_TOKEN_HEADROOM=1.5
LLM_TIMEOUT=240
LLM_MAX_CONCURRENCY=4
LLM_MAX_RETRIES=2
LLM_RETRY_DELAY=2.0
