# Secrets. local.settings.json holds the Azure Functions credentials and .env the
# rest; .funcignore keeps both out of the deployment package, and this keeps them
# out of the repository.
.env
local.settings.json

# The local stores' contents. Anchored, so the storage/ and jobs/ *packages* inside
# the module are unaffected — the same trap .funcignore has to avoid.
/storage/
/jobs/

# Generated by scripts/make_fixtures.py from a tenant's real export, so it is
# customer data and does not belong in the repository.
/fixtures/

.venv/
.pytest_cache/
__pycache__/
*.pyc
