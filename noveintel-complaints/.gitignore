# ── Secrets and settings ─────────────────────────────────────────────────────
# Never commit credentials. The *.example templates are the only versions that
# belong in the repository, and they carry no values.
.env
.env.*
!.env.example
local.settings.json
local.settings.*.json
secrets.toml
*.pem
*.key
*.pfx
*.p12

# ── Run output and job records ───────────────────────────────────────────────
# Everything a run produces is customer data: the reports, the per-case
# workbook, the report JSON, the stored requests and the job records holding
# full results. Anchored, so the storage/ and jobs/ *packages* inside the module
# stay tracked — the same trap .funcignore has to avoid.
/storage/
/jobs/
/runs/
/out/
bundle.json
openapi.json
# Reports and workbooks wherever they land. No source file in this service is a
# .docx or .xlsx, so this only ever catches output.
*.docx
*.xlsx

# Request bodies made by scripts/make_fixtures.py from a tenant's real export.
/fixtures/

# Azurite's data files, if it is started without --location.
__azurite_db_*
__blobstorage__/
__queuestorage__/

# ── Logs and test results ────────────────────────────────────────────────────
*.log
.pytest_cache/
.coverage
.coverage.*
htmlcov/
junit*.xml
test-results/
.hypothesis/

# ── Local tooling ────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc
.DS_Store
